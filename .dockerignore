# Build context is the repo root — keep it small.
node_modules
**/node_modules
**/dist
**/.astro
.git
specs
*.md
.env
.env.*

# Tests never ship, and neither does a fixture left behind by an interrupted
# e2e run (mirrored in .gitignore).
web/tests
web/src/content/**/*-fixture.md
web/test-results
web/playwright-report
