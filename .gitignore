# personal PII — local source material only, never committed
# (about-tal.md stays committed: it carries the identity-relevant facts, no contact details)
specs/research/Tal_Bendet_CV.pdf

node_modules/
.env
.env.*
.DS_Store
*.log

# e2e fixtures copied into the collections by web/tests/install-fixtures.ts.
# They are test artifacts with a real content path, so the safety net is here
# as well as in the clean step (mirrored in .dockerignore).
web/src/content/**/*-fixture.md
web/test-results/
web/playwright-report/

# The migration's fidelity harness: its own Playwright spec and config, the
# fixture SOURCES it installs, and ~16MB of baseline PNGs (every page x both
# temperatures x three widths, twice over). It is a local verification tool,
# not a checked-in oracle — the one screenshot baseline this repo does commit
# is web/tests/e2e/__screenshots__/, and keeping the two apart is the point.
# Without this rule a single `git add -A` commits 169 files of it.
web/.fidelity/
