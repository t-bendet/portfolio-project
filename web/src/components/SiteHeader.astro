---
// Global header — eyebrow (with the mark) · primary nav.
// specs/navigation.md §1–3. Content-independent (N-1): nothing here varies
// with how much the site contains.
//
// Not sticky — a deliberate decision, not an omission (navigation.md §1).
// The header scrolls away with the page and always has; a reader who pins it
// is reversing a decision, not filling a gap.
//
// ── the eyebrow ───────────────────────────────────────────────────────────
//
// ADR 0001: identity, not decoration (typography.md §6). The mono face, the
// 11px step and the 0.2em tracking are the mark's own typography, which is
// why they sit on the <p> and are inherited rather than restated per span.
//
// Linking the mark must not alter its resting appearance (navigation.md §3.3
// rule 3), so the anchor re-declares `text-muted` against global.css's base
// `a { color: var(--text) }` and drops the underline. Only the hover step
// distinguishes it from the surrounding eyebrow text.
//
// The mark is an LTR run inside a line that is RTL on the Hebrew pages, and
// `direction` / `unicode-bidi` have no utilities in Tailwind 4.3.3 — none,
// verified against the installed package. They are written as arbitrary
// PROPERTIES, `[direction:ltr]` and `[unicode-bidi:isolate]`. Without the
// isolation the bidi algorithm reorders `T://bendet` around the colon and
// slashes when the paragraph direction flips.
//
// Hebrew is unicameral; 0.2em tracking is a Latin-caps idiom (typography.md
// §6, navigation.md §3.3 rule 4). The Hebrew segment therefore cancels both
// inherited values — and `tracking-[normal]` is deliberate, NOT
// `tracking-normal`. Tailwind's `tracking-normal` resolves through
// `--tracking-normal` to `0em`, a computed zero, where navigation.md N-7 and
// typography.md §6 pin the KEYWORD `normal` on Hebrew runs. The brackets are
// what emit the keyword. (`normal-case` needs no such care — it already
// compiles to `text-transform: none`.)
//
// The two cancelling utilities sit on the <span> while `uppercase` and
// `tracking-eyebrow` sit on the <p>, so this is inheritance being overridden
// on a descendant, not two utilities racing in one cascade — the emitted
// order of the pair is irrelevant.
//
// ── the nav ───────────────────────────────────────────────────────────────
//
// `flex-wrap` is the narrow-viewport behaviour: wrap, no disclosure menu.
// The items reflow onto a second line and stay reachable; nothing collapses
// behind a control. The link idiom itself lives in NavLink.astro.

import NavLink from './NavLink.astro';

interface Props {
  /** Eyebrow section segment — one of the eight in navigation.md §3.2 */
  section: string;
  /** Language of that segment */
  sectionLang: 'en' | 'he';
}

const { section, sectionLang } = Astro.props;

const locale = Astro.currentLocale ?? 'en';
const path = Astro.url.pathname;

// Fixed set and order (navigation.md §2.1). Each item is labelled in the
// language of the page it leads to (§2.2) — four English words and one
// Hebrew word, in both locales.
const items = [
  { href: '/writing/', label: 'writing', lang: 'en' },
  { href: '/he/writing/', label: 'תרגומים', lang: 'he' },
  { href: '/projects/', label: 'projects', lang: 'en' },
  { href: '/about/', label: 'about', lang: 'en' },
  { href: '/contact/', label: 'contact', lang: 'en' },
] as const;

// aria-current="page" on an exact URL match only; child routes mark their
// section with "true" (§2.3). Routes with no owning nav item — /colophon/,
// /404, /he/404 — match nothing, which is the specified behaviour.
function currentState(href: string): 'page' | 'true' | undefined {
  if (path === href) return 'page';
  if (path.startsWith(href)) return 'true';
  return undefined;
}
---

<header class="border-be border-be-border">
  <div class="shell flex flex-wrap items-center justify-between gap-x-8 gap-y-3 pbs-5 pbe-5">
    <p class="font-mono text-size-eyebrow tracking-eyebrow uppercase text-muted">
      <a
        class="text-muted no-underline [direction:ltr] [unicode-bidi:isolate] [&:hover]:text-text"
        href="/"
        aria-current={path === '/' ? 'page' : undefined}>T://bendet</a
      >
      <span class="ms-[0.4em] me-[0.4em]" aria-hidden="true">·</span>
      <span
        class:list={[{ 'normal-case tracking-[normal]': sectionLang === 'he' }]}
        lang={sectionLang === locale ? undefined : sectionLang}>{section}</span
      >
    </p>

    <nav aria-label="primary">
      <ul class="flex flex-wrap items-center gap-x-2 gap-y-1 list-none m-0 p-0">
        {
          items.map((item) => (
            <li>
              <NavLink
                href={item.href}
                current={currentState(item.href)}
                lang={item.lang === locale ? undefined : item.lang}
              >
                {item.label}
              </NavLink>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
