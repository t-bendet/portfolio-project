---
// Translated article (/he/writing/[id]/) — specs/pages/translations-article.md.
// Deep-dive editorial archetype under dir="rtl", set once on <html> from the
// locale by the layout. This template sets no `dir` anywhere; the only
// element that overrides direction is a code panel, and that rule lives in
// global.css because it is a property of code, not of this page.
//
// Self-canonical: no rel="canonical" to the original, no hreflang alternates
// (specs/content-model.md §4.2).
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleGrid from '../../../components/ArticleGrid.astro';
import ArticleHeader from '../../../components/ArticleHeader.astro';
import ArticleMeta from '../../../components/ArticleMeta.astro';
import Contents from '../../../components/Contents.astro';
import EndMatter from '../../../components/EndMatter.astro';
import EndMatterLink from '../../../components/EndMatterLink.astro';
import Siblings from '../../../components/Siblings.astro';
// The prose rules for the rendered MDX, and the credit blocks below, which
// are direct children of the body and are spaced by its own child rule. Both
// stay in the stylesheet: see the note above the closing credit.
import '../../../styles/article.css';

export async function getStaticPaths() {
  const entries = await getCollection('translations', ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
const { original } = entry.data;

const sections = headings.filter((heading) => heading.depth === 2);
const hasContents = sections.length >= 3;

// Siblings are translations only. Falling back to English articles would
// append LTR rows to an RTL page and tell a Hebrew reader that this section
// is a waiting room (§4).
const others = entries
  .filter((other) => other.id !== entry.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const siblings = others.length >= 2 ? others.slice(0, 2) : [];

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title={`${entry.data.title} · T://bendet`}
  description={entry.data.description}
  section="תרגומים"
  sectionLang="he"
>
  <ArticleGrid hasContents={hasContents}>
    <ArticleHeader
      title={entry.data.title}
      lede={entry.data.description}
      hasContents={hasContents}
    >
      <ArticleMeta
        pubDate={entry.data.pubDate}
        updatedDate={entry.data.updatedDate}
        tags={entry.data.tags}
        lang="he"
      />
    </ArticleHeader>

    {hasContents && <Contents headings={sections} lang="he" />}

    {/* The body keeps its class, and so do the two credit blocks inside it.
        `.article-body > * + *` puts 20px between every child, and the closing
        credit overrides that with 56px — the two rules tie on specificity and
        the second one wins because it is written second. Utilities have no
        source order to rely on: they land in one layer where Tailwind's sort
        decides, and either half of that pair moved out would flip the result
        to the wrong margin on this route alone. So the whole region stays
        CSS. Only the grid placement is a utility (ArticleGrid.astro), because
        grid-column-start and grid-row-start are properties neither rule
        touches. */}
    <article
      class:list={[
        'article-body',
        hasContents && 'min-[900px]:col-start-2 min-[900px]:row-start-2',
      ]}
    >
      {/*
        The opening credit block — required, never conditional, and it
        precedes the first element of the body. CI asserts the ordering, not
        merely the presence (specs/content-model.md §5, assertion 2).

        Script split is deliberate: the sentence is Hebrew, but the original's
        title and its author's name stay in Latin, so the credit is legible to
        someone who cannot read Hebrew (§2.1).

        REVIEW(Tal): the Hebrew below is drafted, not native-checked. What is
        binding and must survive any rewrite: it states that this is a
        translation, it names the author, and it links the original — all
        three, above the body. That trio is a licence condition, not a
        style preference (specs/translations-checklist.md).
      */}
      <aside class="credit">
        <span class="credit-label">תרגום</span>
        <p>
          תרגום לעברית של המאמר{' '}
          <a href={original.url} lang="en" rel="noopener">
            <bdi>{original.title}</bdi>
          </a>{' '}
          מאת <bdi lang="en">{original.author}</bdi>
          {
            original.publishedAt && (
              <>
                , שפורסם במקור ב־
                <time datetime={iso(original.publishedAt)}>
                  {iso(original.publishedAt)}
                </time>
              </>
            )
          }.
        </p>
      </aside>

      <Content />

      {/* The closing credit: the same link, where acting on it is natural. */}
      {/* REVIEW(Tal): drafted Hebrew, not native-checked. */}
      <p class="closing-credit">
        לקריאת המקור באנגלית:{' '}
        <a href={original.url} lang="en" rel="noopener">
          <bdi>{original.title}</bdi>
        </a>
      </p>
    </article>

    <EndMatter hasContents={hasContents}>
      <EndMatterLink href="/he/writing/">תרגומים</EndMatterLink>

      {
        siblings.length > 0 && (
          <Siblings
            heading="תרגומים נוספים"
            lang="he"
            items={siblings.map((sibling) => ({
              href: `/he/writing/${sibling.id}/`,
              title: sibling.data.title,
            }))}
          />
        )
      }
    </EndMatter>
  </ArticleGrid>
</Base>
