---
// Writing index (/writing/) — specs/pages/writing-index.md.
// Overview archetype. Sections 2–4 are permanent: they render identically
// whether the section holds zero entries or fifty, which is what lets the
// empty state be the same page minus the list rather than a page about its
// own emptiness (§4).
//
// No pagination, no excerpts beyond `description`, no view counts (§5).
//
// The archetype's devices are components, not classes — IndexHeader.astro
// carries why, and the same eight are used by /he/writing/ and /projects/ so
// the three indexes cannot drift apart.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChipList from '../../components/ChipList.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import Standing from '../../components/Standing.astro';
import CrossLink from '../../components/CrossLink.astro';
import EntryList from '../../components/EntryList.astro';
import EntryRow from '../../components/EntryRow.astro';
import SectionTerms from '../../components/SectionTerms.astro';
import RoutesOut from '../../components/RoutesOut.astro';
import RouteOutLink from '../../components/RouteOutLink.astro';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Routes out are computed from what actually exists, not asserted (§4.3).
// The translations index is offered only when it has something to show.
const translations = await getCollection('translations', ({ data }) => !data.draft);

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title="writing · T://bendet"
  description="Long-form writing on frontend work and the infrastructure under it — what each decision bought, and what it cost."
  section="writing"
>
  <IndexHeader title="writing">
    {/* Permanent content, in the tradeoff register: it reads the same at zero
        entries and at fifty (§2, section 3). */}
    <Standing>
      Long-form pieces about frontend work and the infrastructure under it. Each one says
      what a decision bought and what it cost, because the second half is the part that
      is usually missing.
    </Standing>

    {/* The label is Hebrew and carries lang="he" so the destination's
        language is disclosed before the click (specs/navigation.md §2.2). */}
    <CrossLink>
      Translations of other developers' articles into Hebrew are in{' '}
      <a href="/he/writing/" lang="he">תרגומים</a>.
    </CrossLink>
  </IndexHeader>

  {
    entries.length > 0 ? (
      <EntryList>
        {entries.map((entry) => (
          <EntryRow
            href={`/writing/${entry.id}/`}
            title={entry.data.title}
            description={entry.data.description}
          >
            <time datetime={iso(entry.data.pubDate)}>{iso(entry.data.pubDate)}</time>
            {/* An update never silently replaces the publication date. */}
            {entry.data.updatedDate && (
              <span>
                updated{' '}
                <time datetime={iso(entry.data.updatedDate)}>
                  {iso(entry.data.updatedDate)}
                </time>
              </span>
            )}
            {entry.data.tags.length > 0 && <ChipList tags={entry.data.tags} />}
          </EntryRow>
        ))}
      </EntryList>
    ) : (
      <>
        {/* The section's terms — true on day 1 and on day 400. No dates, no
            schedule, no "soon" (§4.2). Delete the sentence saying the list is
            empty and the page still states what the section is; that is the
            test this block has to pass. */}
        <SectionTerms>
          <p>
            What belongs here: pieces that work through one real technical decision — what
            was chosen, what was given up, and what it cost to live with afterwards.
          </p>
          <p>
            What does not: link roundups, release notes, framework announcements, and
            anything that would be wrong in a month.
          </p>
        </SectionTerms>

        <RoutesOut>
          {translations.length > 0 && (
            <RouteOutLink href="/he/writing/" lang="he">
              תרגומים
            </RouteOutLink>
          )}
          <RouteOutLink href="/projects/">projects</RouteOutLink>
          <RouteOutLink href="/about/">about</RouteOutLink>
        </RoutesOut>
      </>
    )
  }
</Base>
