---
// About (/about/) — specs/pages/about.md. Deep-dive editorial archetype, so
// the header and prose components come from article.css: About is the same
// archetype as an article, not an index (§2 row 8 of specs/routes/sitemap.md).
//
// No dynamic layer, permanently: no reads, no view event, no dynamic-layer
// script. The only client script on this route is the global theme script
// (ADR 0002, specs/design/tokens.md §2).
//
// Voice is Tal's, and sharper here than anywhere (§2.3): the prose slots are
// left as TODO(Tal) rather than filled with plausible copy, which is the same
// convention as / and /404. What is filled below is fact, not register — the
// background rows, which are a reference list, not a voice surface.
//
// Not built, by §5: a /uses block, skills bars, company logos, testimonials,
// a timeline widget, workspace photos, any hint of the second theme.
import Base from '../layouts/Base.astro';
// Both are null today: the portrait is undigitized (ADR 0018) and the CV is
// unpublished. Absent means absent — no placeholder, no reserved box, no
// "available on request" (§2.2, §3). See the module for how to turn either on.
import { portrait, cv } from '../lib/about';
import '../styles/article.css';

// Section 5, the reference register the prototypes already use
// (build-tools-overview.html's config-row device). Facts from
// specs/research/about-tal.md. No version numbers and no computed durations:
// a row that must be edited to stay true is written wrong (§2.3).
const background: { label: string; value: string }[] = [
  {
    label: 'education',
    value: 'AppleSeeds Academy — full stack bootcamp, 720 hours',
  },
  {
    label: 'internship',
    value: 'Cambium — two months, out of the bootcamp',
  },
  {
    label: 'frontend',
    value: 'React · TypeScript · React Router · Redux · TanStack Query · Tailwind CSS · Vite · Radix UI',
  },
  {
    label: 'backend',
    value: 'Node.js · Express · SQL · Prisma · MongoDB · REST · JWT',
  },
  {
    label: 'infrastructure',
    value: 'Docker · AWS · GitHub Actions · Turborepo · pnpm',
  },
];
---

{/* TODO(Tal): the meta description */}
<Base title="about · T://bendet" description="TODO: Tal's copy" section="about">
  <header class="article-header">
    <h1>about</h1>

    {/* TODO(Tal): the one-line lede, in your own register. Not a job title,
        not a tagline — the sentence you would say to someone who just read
        something here and wanted to know who wrote it. */}
    <p class="lede"></p>
  </header>

  <div class:list={['bio-slot', { 'with-portrait': portrait !== null }]}>
    <div class="bio article-body">
      {/* TODO(Tal): the bio (§2, section 3) — who you are and what you have
          actually done: the Amdocs design-system years, the translation work,
          what you are available for. Prose, first person, no bullet list.
          Binding: zero reference density (no mythology, no HP, no protocol
          wordplay), no template phrasing ("passionate about", "crafting
          delightful experiences", "results-driven"), and no sentence that
          would be wrong in eighteen months if nobody touched it — no
          "currently", no "recently", no "X years of experience". */}
    </div>

    {
      /* Unframed, unfiltered, no plate, no shadow, never mythologized
         (§2.1). Deliberately the one un-systematized element on the site. */
      portrait !== null && (
        <img class="portrait" src={portrait.src} alt={portrait.alt} width="320" height="320" />
      )
    }
  </div>

  <section class="section">
    <h2>the work</h2>

    {/* TODO(Tal): what /now would have carried, minus the currency promise
        (specs/routes/sitemap.md §4) — the kind of work you are doing and
        want, written to stay true without maintenance. If a sentence needs a
        date to be honest, give it the date rather than "at the moment". */}
    <div class="article-body"></div>
  </section>

  <section class="section">
    <h2>background</h2>

    <dl class="background">
      {
        background.map((row) => (
          <div class="background-row">
            <dt class="background-label">{row.label}</dt>
            <dd class="background-value">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    cv !== null && (
      <section class="section">
        <h2>cv</h2>
        {/* Disclosed as a file: format and the fact that it downloads (§2). */}
        <p class="cv-line">
          <a class="cv-link" href={cv.href} download>
            cv
          </a>
          <span class="cv-detail">PDF, {cv.size} — downloads</span>
        </p>
      </section>
    )
  }

  {/* TODO(Tal): the sentence around this link (§2, section 7). One line,
      pointing at /contact/. Not a call to action, and never "let's connect"
      or anything in its register. */}
  <p class="contact-pointer">
    <a href="/contact/">contact</a>
  </p>
</Base>

<style>
  /*
   * The bio-beside-portrait slot (ADR 0018, specs/pages/about.md §2.2). The
   * composition is designed around two elements; when the drawing is absent
   * the grid is one column and there is nothing to see — no empty track, no
   * reserved box. Logical properties throughout, as everywhere.
   */
  .bio-slot {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin-block-start: 48px;
  }

  @media (min-width: 900px) {
    .bio-slot.with-portrait {
      grid-template-columns: minmax(0, 1fr) 320px;
      column-gap: 48px;
      align-items: start;
    }
  }

  /* Unframed: no border, no background plate, no filter, no shadow (§2.1). */
  .portrait {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
  }

  .section {
    margin-block-start: 72px;
  }

  .section h2 {
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 600;
    letter-spacing: var(--track-display);
    color: var(--text-strong);
    padding-block-end: 12px;
    border-block-end: 1px solid var(--border);
  }

  /* The reference register, transcribed from the config-row device in
     specs/design/prototypes/build-tools-overview.html: mono label, prose
     value, one rule between rows. */
  .background {
    margin: 0;
  }

  .background-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 24px;
    padding-block: 16px;
    border-block-end: 1px solid var(--border);
  }

  .background-row:last-child {
    border-block-end: none;
  }

  @media (min-width: 700px) {
    .background-row {
      grid-template-columns: 160px minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .background-label {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--muted);
  }

  .background-value {
    margin: 0;
    font-size: var(--size-meta);
    line-height: var(--leading-body);
    color: var(--text);
  }

  .cv-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    margin-block-start: 20px;
  }

  .cv-link {
    font-family: var(--font-mono);
    font-size: var(--size-meta);
    color: var(--text);
    text-decoration: none;
    border-inline-start: 2px solid var(--border-strong);
    padding-inline-start: 12px;
    transition: color var(--motion-hover) ease;
  }

  .cv-link:hover {
    color: var(--text-strong);
  }

  .cv-detail {
    font-family: var(--font-mono);
    font-size: var(--size-eyebrow);
    color: var(--muted);
  }

  .contact-pointer {
    margin-block-start: 72px;
    font-size: var(--size-body);
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-link {
      transition: none;
    }
  }
</style>
