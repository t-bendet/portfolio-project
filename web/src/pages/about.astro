---
// About (/about/) — specs/pages/about.md. Deep-dive editorial archetype, so
// the header and prose components come from article.css: About is the same
// archetype as an article, not an index (§2 row 8 of specs/routes/sitemap.md).
//
// No dynamic layer, permanently: no reads, no view event, no dynamic-layer
// script. The only client script on this route is the global theme script
// (ADR 0002, specs/design/tokens.md §2).
//
// The voice constraints are sharper here than anywhere (§2.3): zero
// reference density, no template phrasing, and no sentence that would be
// wrong in eighteen months if nobody touched it. The one sentence that must
// be maintained is the availability line in "the work", and it is maintained
// by editing rather than by a status widget — that trade is §2.3's.
//
// Not built, by §5: a /uses block, skills bars, company logos, testimonials,
// a timeline widget, workspace photos, any hint of the second theme.
import Base from '../layouts/Base.astro';
// Both are null today: the portrait is undigitized (ADR 0018) and the CV is
// unpublished. Absent means absent — no placeholder, no reserved box, no
// "available on request" (§2.2, §3). See the module for how to turn either on.
import { portrait, cv } from '../lib/about';
// The prose rules the bio and the register bodies are built from. The masthead
// that used to live in this stylesheet is ArticleHeader now, and it is passed
// no `hasContents`: this page is not an article grid, so it must not be given
// the placement that only makes sense inside one.
import '../styles/article.css';
import ArticleHeader from '../components/ArticleHeader.astro';
// The section device and the label/value row, shared with /colophon/ and
// /contact/ — one reference register across the three authored pages.
import Section from '../components/Section.astro';
import RefRows from '../components/RefRows.astro';
import RefRow from '../components/RefRow.astro';

// Section 5, the reference register the prototypes already use
// (build-tools-overview.html's config-row device). Facts from
// specs/research/about-tal.md. No version numbers and no computed durations:
// a row that must be edited to stay true is written wrong (§2.3).
const background: { label: string; value: string }[] = [
  {
    label: 'education',
    value: 'AppleSeeds Academy — full stack bootcamp, 720 hours',
  },
  {
    label: 'internship',
    value: 'Cambium — two months, out of the bootcamp',
  },
  {
    label: 'frontend',
    value: 'React · TypeScript · React Router · Redux · TanStack Query · Tailwind CSS · Vite · Radix UI',
  },
  {
    label: 'backend',
    value: 'Node.js · Express · SQL · Prisma · MongoDB · REST · JWT',
  },
  {
    label: 'infrastructure',
    value: 'Docker · AWS · GitHub Actions · Turborepo · pnpm',
  },
];
---

<Base
  title="about · T://bendet"
  description="Tal Bendet — full stack developer in Tel Aviv. Four years of design-system work at Amdocs, Hebrew translations of technical articles, and the infrastructure behind this site."
  section="about"
>
  <ArticleHeader
    title="about"
    lede="Design systems for four years, translation work on the side, and a site built the hard way on purpose."
  />

  {/* The bio-beside-portrait slot (ADR 0018, specs/pages/about.md §2.2). The
      composition is designed around two elements; when the drawing is absent
      the grid is one column and there is nothing to see — no empty track, no
      reserved box. That is why the second column lives on the conditional
      branch rather than in the base string: the branch is not a modifier on a
      two-column layout, it IS the two-column layout. ArticleGrid.astro splits
      the same way, for the same reason.

      Logical properties throughout, as everywhere.

      `gap-8` is the 32px shorthand on both axes; `min-[900px]:gap-x-12` widens
      the column gap alone to 48px and leaves the row gap at 32px, which is
      exactly what the media query did. A shorthand landing after a longhand
      would undo it, so the emitted order is load-bearing: 4.3.3 emits variant
      rules after the unvariated ones (checked in its output for EntryRow's
      hover — same layer, same question), and the widened gap is the variant.

      `min-[900px]:items-start` emits `align-items: flex-start` where the rule
      said `align-items: start`. On a grid container the CSS Box Alignment
      spec defines flex-start to behave as start, so the keyword changes and
      the layout cannot. */}
  <div
    class:list={[
      'grid grid-cols-[minmax(0,1fr)] gap-8 mbs-12',
      portrait !== null &&
        'min-[900px]:grid-cols-[minmax(0,1fr)_320px] min-[900px]:gap-x-12 min-[900px]:items-start',
    ]}
  >
    {/* Zero reference density here, by §2.3: the person carries this page,
        so no mythology, no fandom, no protocol wordplay past the eyebrow.
        Every date is a closed span — nothing here needs editing to stay
        true. */}
    <div class="bio article-body">
      <p>
        I am Tal Bendet, a full stack developer in Tel Aviv. From 2021 to 2025 I worked at
        Amdocs on shared frontend infrastructure: a React and TypeScript design system and
        component library that several product teams built their own products out of, and
        the frontend delivery for one large telecom deployment, end to end.
      </p>
      <p>
        Design-system work teaches a particular discipline. Every component you ship is a
        promise to someone who will never read your documentation, and every change is a
        negotiation with the teams already depending on the old behaviour. It makes you
        slow in the specific places where being slow is cheaper than being sorry, and it is
        where most of my opinions about interfaces come from.
      </p>
      <p>
        I also translate technical articles into Hebrew, with the original author's credit
        and permission. The Israeli dev community reads English perfectly well; it just
        reads Hebrew faster, and most of the good explanations were written in English.
      </p>
      <p>
        In late 2025 I stopped for a planned break, which is a mild way to describe the
        arrival of twins.
      </p>
    </div>

    {
      /* Unframed, unfiltered, no plate, no shadow, never mythologized
         (§2.1). Deliberately the one un-systematized element on the site,
         which is what the three utilities below say: it lays out and it
         scales, and nothing decorates it.

         `block-auto` is `block-size: auto` and `max-inline-full` is
         `max-inline-size: 100%` — 4.3.3's own logical size namespaces, the
         pair that keeps a drawing inside its column without stretching it.
         The physical `h-auto` exists and is not used: the rule this replaces
         binds logically, like every other directional property in this repo.
         Read `block-auto` as a size and not as a relative of `block` one
         space to its left, which is `display: block`; the two namespaces
         collide in the eye and nowhere else. */
      portrait !== null && (
        <img
          class="block max-inline-full block-auto"
          src={portrait.src}
          alt={portrait.alt}
          width="320"
          height="320"
        />
      )
    }
  </div>

  <Section heading="the work">
    {/* What /now would have carried, minus the currency promise
        (specs/routes/sitemap.md §4). The availability sentence is the one
        thing on this page that has to be edited when it stops being true —
        which is the deal §2.3 struck: an edited sentence rather than a status
        badge that goes stale silently. */}
    <div class="article-body">
      <p>
        The work I want is the work I have been doing: frontend systems that other
        developers build on — design systems, component libraries, the build and delivery
        around them — and increasingly the infrastructure underneath. This site is the
        current instance of that. Its checks and its build are hand-written rather than
        bought, which is the shortest honest way to say what I want more of.
      </p>
      <p>
        I am open to frontend or full-stack roles in Israel. When that stops being true,
        this paragraph changes.
      </p>
    </div>
  </Section>

  <Section heading="background">
    <RefRows as="dl">
      {
        background.map((row) => (
          <RefRow as="div">
            <dt class="font-mono text-size-label tracking-label uppercase text-muted">
              {row.label}
            </dt>
            <dd class="m-0 text-size-meta leading-body text-text">{row.value}</dd>
          </RefRow>
        ))
      }
    </RefRows>
  </Section>

  {
    cv !== null && (
      <Section heading="cv">
        {/* Disclosed as a file: format and the fact that it downloads (§2).

            `gap: 8px 16px` is row then column, so it is `gap-y-2 gap-x-4`:
            16px between the link and its detail on one line, 8px between the
            lines once the row wraps. Reading the two the wrong way round is a
            change nobody would call a bug and nobody would call intended
            either. */}
        <p class="flex flex-wrap items-baseline gap-x-4 gap-y-2 mbs-5">
          {/* The anchor's class string is RouteOutLink.astro's, character for
              character — mono, meta size, a 2px --border-strong edge on the
              inline start with 12px of padding after it, and a colour move to
              --text-strong on hover. That component is not imported because it
              renders its own list item and this anchor sits in a paragraph, so
              the duplication is a decision taken here rather than an accident:
              if the routes-out link changes, this changes with it.

              `[&:hover]:` and never `hover:`, which v4 wraps in
              `@media (hover: hover)` and would therefore drop on touch.
              `transition-[color]` and never `transition-colors`, which
              declares ten properties where this rule transitions one.
              `motion-reduce:transition-none` is the prefers-reduced-motion
              block that stood at the foot of this stylesheet; it existed for
              this one rule and for nothing else on the page. */}
          <a
            class="font-mono text-size-meta text-text no-underline border-s-2 border-s-border-strong ps-3 transition-[color] duration-(--motion-hover) ease-[ease] motion-reduce:transition-none [&:hover]:text-text-strong"
            href={cv.href}
            download
          >
            cv
          </a>
          <span class="font-mono text-size-eyebrow text-muted">PDF, {cv.size} — downloads</span>
        </p>
      </Section>
    )
  }

  {/* One line, and not an invitation (§2, section 7). `mbs-18` is the 72px
      that sets it apart from the register above — the separation is space
      rather than a rule or a heading, because a heading would announce it as
      a section and this is a footnote to the page. Body size, muted: quieter
      than the prose it follows, and the anchor inside it keeps the site's
      default link treatment. */}
  <p class="mbs-18 text-size-body text-muted">
    Work, translation requests, and article suggestions: <a href="/contact/">contact</a>
  </p>
</Base>
