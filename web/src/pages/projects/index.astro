---
// Projects index (/projects/) — specs/pages/projects-index.md.
// Overview archetype, the card grid being the archetype's native pattern.
// Sections 2–3 are permanent: they render identically at zero entries and at
// twenty, which is what makes the empty state this page minus its grid rather
// than a page about its own emptiness (§4).
//
// No dynamic layer here, and that absence is permanent, not deferred: §2's
// header and specs/routes/sitemap.md §2 row 6 both say "none — no reads, and
// no view event". The only client script on this route is the global theme
// script (ADR 0002, specs/design/tokens.md §2).
//
// Not built, by §2.4: screenshots and device mockups, a featured-project hero,
// filtering by stack, status badges, view counts, GitHub stars.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import CardGrid from '../../components/CardGrid.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import Standing from '../../components/Standing.astro';
import SectionTerms from '../../components/SectionTerms.astro';
import RoutesOut from '../../components/RoutesOut.astro';
import RouteOutLink from '../../components/RouteOutLink.astro';

// `order`, not a date: projects are a curated set, not a timeline
// (specs/content-model.md §3.3).
const entries = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Routes out are computed from what actually exists, not asserted (§4).
const writing = await getCollection('writing', ({ data }) => !data.draft);
const translations = await getCollection('translations', ({ data }) => !data.draft);
---

<Base
  title="projects · T://bendet"
  description="A short list of things Tal Bendet built and finished far enough that someone else can run them or read the source."
  section="projects"
>
  {/* The header, the standing line, the terms and the routes out are the
      overview archetype's shared devices — the same components /writing/ and
      /he/writing/ render. IndexHeader.astro carries why they are components. */}
  <IndexHeader title="projects">
    {/* Permanent content: it renders identically at zero entries and at
        twenty (§2, section 3). */}
    <Standing>
      Things built far enough that someone else can run them or read the source. A short
      list rather than everything ever started — what is here was chosen, and each one
      says where it actually lives.
    </Standing>
  </IndexHeader>

  {
    entries.length > 0 ? (
      /* This page and the home page used to hold byte-identical copies of the
         card's markup, deliberately, under a comment saying so: §2.2's
         disclosure test — no two cards with visually identical affordances
         produce different navigation outcomes — is written across the site, so
         there has to be one card. The copies are now one component, and the
         test holds because there is nothing left to keep in agreement. */
      <CardGrid>
        {entries.map((entry) => (
          <Card entry={entry} />
        ))}
      </CardGrid>
    ) : (
      <>
        {/* One line, no promise and no date. Never a placeholder card, a
            "coming soon" tile, or a link to a GitHub profile standing in for a
            project list — §4 names that last one as the tempting wrong move.
            Thinner than /writing/'s empty state on purpose: this one is a
            formality (§4). */}
        <SectionTerms>
          <p>Nothing is listed here yet.</p>
        </SectionTerms>

        <RoutesOut>
          {writing.length > 0 && <RouteOutLink href="/writing/">writing</RouteOutLink>}
          {translations.length > 0 && (
            <RouteOutLink href="/he/writing/" lang="he">
              תרגומים
            </RouteOutLink>
          )}
          {/* Unconditional, because a static page is what keeps R-4 (no dead
              ends, specs/navigation.md §7.2) true while both collections are
              empty — the state the site is in today. */}
          <RouteOutLink href="/about/">about</RouteOutLink>
        </RoutesOut>
      </>
    )
  }
</Base>
